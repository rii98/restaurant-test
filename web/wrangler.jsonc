// Cloudflare Workers config.
// Static pages are served straight from ./dist (no code runs); live pages run in the Worker below.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "restaurant-test",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // The Astro adapter fills in "main" (the Worker code) and the "assets" binding automatically.

  // D1 = Cloudflare's free SQL database (SQLite). Reachable in code as env.DB
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "restaurant-test-db",
      "database_id": "a6285b55-78a6-46ec-bebe-e51957f32314",
      "migrations_dir": "migrations"
    }
  ],

  // Plain (non-secret) config available as env.X at runtime
  "vars": {
    "RESTAURANT_TIMEZONE": "America/Chicago",
    "SEATS_PER_SLOT": "20"
  }
  // Secrets (e.g. ADMIN_PASSWORD) are NOT stored here:
  //   local: .dev.vars file     production: `npx wrangler secret put ADMIN_PASSWORD`
}
