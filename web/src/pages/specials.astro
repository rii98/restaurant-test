---
// LIVE PAGE: runs on Cloudflare on every visit. Edit a special in Sanity → refresh → it's there.
export const prerender = false

import Base from '../layouts/Base.astro'
import SanityImg from '../components/SanityImg.astro'
import {getSettings} from '../lib/data'
import {liveClient, isSanityConfigured} from '../lib/sanity'
import {specialsQuery} from '../lib/queries'
import {demoSpecials} from '../lib/demo-data'
import {formatPrice} from '../lib/format'
import {prettyDate, todayIn} from '../lib/time'
import {runtime} from '../lib/server'
import type {Special} from '../lib/types'

const s = await getSettings()
const {timeZone} = runtime(s)
const today = todayIn(timeZone)

const specials = isSanityConfigured
  ? await liveClient.fetch<Special[]>(specialsQuery, {today})
  : demoSpecials(today)

// Tell browsers/CDNs not to keep an old copy — this page must always be fresh.
Astro.response.headers.set('Cache-Control', 'no-store')
const renderedAt = new Date().toLocaleTimeString('en-US', {timeZone, hour: 'numeric', minute: '2-digit', second: '2-digit'})
---
<Base title="Today's Specials" description={`Today's specials at ${s.name}.`}>
  <section class="page-head container narrow">
    <p class="eyebrow">{prettyDate(today)}</p>
    <h1>Today's specials</h1>
    <p class="live-pill"><span class="live-dot"></span> Live · updated {renderedAt}</p>
  </section>

  <div class="container narrow section-tight">
    {specials.length === 0 ? (
      <p class="notice">No specials today — check the <a href="/menu/">full menu</a>.</p>
    ) : (
      <div class="grid-2">
        {specials.map((sp) => (
          <article class:list={['special', {soldout: sp.soldOut}]}>
            {sp.image && <SanityImg image={sp.image} aspect={4 / 3} sizes="(min-width: 800px) 380px, 100vw" class="dish-img" />}
            <div class="dish-head">
              <h3>{sp.title}</h3>
              <span class="dot-leader" aria-hidden="true"></span>
              <span class="price">{formatPrice(sp.price, s.currency)}</span>
            </div>
            {sp.description && <p class="muted">{sp.description}</p>}
            {sp.soldOut && <p class="badge-soldout">Sold out</p>}
          </article>
        ))}
      </div>
    )}
  </div>
</Base>
