---
import Base from '../layouts/Base.astro'
import Hours from '../components/Hours.astro'
import {getSettings} from '../lib/data'

const s = await getSettings()
const formKey = import.meta.env.PUBLIC_WEB3FORMS_KEY
const a = s.address
const mapsLink = a ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${s.name} ${a.street} ${a.city}`)}` : undefined
---
<Base title="Visit & Contact" description={`Opening hours, address and contact details for ${s.name}.`}>
  <section class="page-head container">
    <h1>Visit us</h1>
  </section>

  <div class="container two-col section-tight">
    <div>
      <h2>Where</h2>
      {a && <p class="lead">{a.street}<br />{a.city}{a.region && `, ${a.region}`} {a.postalCode}</p>}
      {mapsLink && <p><a href={mapsLink} rel="noopener">Open in Google Maps →</a></p>}
      {s.phone && <p>Call: <a href={`tel:${s.phone.replace(/[^+\d]/g, '')}`}>{s.phone}</a></p>}
      <h2>Hours</h2>
      <Hours hours={s.hours} />
    </div>

    <div>
      <h2>Send us a message</h2>
      {formKey ? (
        <form class="form" action="https://api.web3forms.com/submit" method="POST" id="contact-form">
          <input type="hidden" name="access_key" value={formKey} />
          <input type="hidden" name="subject" value={`New message from ${s.name} website`} />
          <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" />
          <label>Name <input name="name" required autocomplete="name" /></label>
          <label>Email <input name="email" type="email" required autocomplete="email" /></label>
          <label>Message <textarea name="message" rows="5" required></textarea></label>
          <button class="btn" type="submit">Send</button>
          <p class="form-status" role="status" aria-live="polite"></p>
        </form>
      ) : (
        <p class="notice">Contact form is off. Add <code>PUBLIC_WEB3FORMS_KEY</code> to <code>.env</code> to enable it.</p>
      )}
    </div>
  </div>

  {s.mapEmbedUrl && (
    <div class="container section-tight">
      <iframe class="map" src={s.mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={`Map to ${s.name}`}></iframe>
    </div>
  )}
</Base>

<script>
  // Progressive enhancement: submit without leaving the page. Works without JS too.
  const form = document.querySelector<HTMLFormElement>('#contact-form')
  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const status = form.querySelector('.form-status')!
    status.textContent = 'Sending…'
    try {
      const res = await fetch(form.action, {method: 'POST', body: new FormData(form), headers: {Accept: 'application/json'}})
      const json = await res.json()
      status.textContent = json.success ? 'Thanks! We will get back to you soon.' : 'Something went wrong. Please call us instead.'
      if (json.success) form.reset()
    } catch {
      status.textContent = 'Network error. Please call us instead.'
    }
  })
</script>
